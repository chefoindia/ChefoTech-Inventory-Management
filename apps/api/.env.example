NODE_ENV=development
PORT=4000
API_BASE_PATH=/api/v1
WEB_ORIGIN=http://localhost:3000

# MongoDB must be a replica set (Atlas or local rs) - transactions are required
MONGODB_URI=mongodb://localhost:27017/pharmaos?replicaSet=rs0
# Optional: comma-separated DNS servers for Node if mongodb+srv lookups fail (e.g. 8.8.8.8,1.1.1.1)
DNS_SERVERS=

JWT_ACCESS_SECRET=change-me-min-32-characters-long
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
COOKIE_SECURE=false

# Email (Brevo). Leave BREVO_API_KEY empty to log emails to console.
BREVO_API_KEY=
EMAIL_FROM_NAME=PharmaOS
EMAIL_FROM_ADDRESS=no-reply@example.com

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional: Firebase Admin for phone OTP login (base64 of service account JSON)
FIREBASE_SERVICE_ACCOUNT_BASE64=

# Plan billing (Razorpay). Empty = plan changes are recorded manually by the owner.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# SMS: MSG91 (India, DLT template with a {{message}} variable) or Twilio. Empty = console.
MSG91_AUTH_KEY=
MSG91_SENDER_ID=
MSG91_TEMPLATE_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# WhatsApp Business (Meta Cloud API). Empty = console.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Web push (generate with: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@example.com

# Optional separate secret for public document share links (defaults to JWT_ACCESS_SECRET)
SHARE_LINK_SECRET=
