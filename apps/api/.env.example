NODE_ENV=development
PORT=4000
API_BASE_PATH=/api/v1
WEB_ORIGIN=http://localhost:3000

# MongoDB must be a replica set (Atlas or local rs) - transactions are required
MONGODB_URI=mongodb://localhost:27017/pharmaos?replicaSet=rs0
# Optional: comma-separated DNS servers for Node if mongodb+srv lookups fail (e.g. 8.8.8.8,1.1.1.1)
DNS_SERVERS=

JWT_ACCESS_SECRET=change-me-min-32-characters-long
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
COOKIE_SECURE=false

# Email (Brevo). Leave BREVO_API_KEY empty to log emails to console.
BREVO_API_KEY=
EMAIL_FROM_NAME=PharmaOS
EMAIL_FROM_ADDRESS=no-reply@example.com

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional: Firebase Admin for phone OTP login (base64 of service account JSON)
FIREBASE_SERVICE_ACCOUNT_BASE64=
